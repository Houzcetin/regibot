# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low
# Local demo only: pretend today is this date. Leave unset (or delete the line) on a public
# deployment so the app uses the real date (Europe/Istanbul).
DEMO_DATE=2026-09-15
PORT=3000
RATE_LIMIT_PER_MIN=10
RATE_LIMIT_PER_DAY=100
GLOBAL_DAILY_LIMIT=1000
